# Copy to .env (gitignored) and fill in. Never commit the real .env.
# Loaded by clockd at startup and by deploy/install.sh via systemd EnvironmentFile.

# Mosquitto credentials for the `clock` user on the Pi.
MQTT_PASSWORD=change-me

# Web UI shared password. Generate the hash with:
#   python -m clockd.hashpw
# then put the HASH in config/clock.yaml (web.password_hash), not here.
# This plaintext var is only used by --sim when no hash is configured.
CLOCK_UI_PASSWORD=

# Session signing key for the UI cookie. Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
CLOCK_SECRET_KEY=

# Optional: Home Assistant REST source (P2)
HASS_URL=
HASS_TOKEN=

# Optional alerting. Both are URLs that act as credentials, which is why they
# live here and not in config/clock.yaml. Set alerts.enabled: true as well.
#
# healthchecks.io -- the dead-man's switch. The controller pings this on a
# timer; if the pings stop, healthchecks emails you. This is the one that
# catches a Pi that has lost power, lost WiFi or hung, because in those cases
# the controller cannot tell you anything itself.
#   Make a check at https://healthchecks.io, period 10 min, grace 20 min.
HEALTHCHECKS_URL=

# ntfy.sh -- push notifications saying *what* broke, while the Pi is still
# alive enough to say so. Pick an unguessable topic name: anyone who knows it
# can read your notifications.
#   NTFY_URL=https://ntfy.sh/weasley-clock-7f3a9c2e
NTFY_URL=
