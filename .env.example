# Copy to .env (gitignored) and fill in. Never commit the real .env.
# Loaded by clockd at startup and by deploy/install.sh via systemd EnvironmentFile.

# Mosquitto credentials for the `clock` user on the Pi.
MQTT_PASSWORD=change-me

# Web UI shared password. Generate the hash with:
#   python -m clockd.hashpw
# then put the HASH in config/clock.yaml (web.password_hash), not here.
# This plaintext var is only used by --sim when no hash is configured.
CLOCK_UI_PASSWORD=

# Session signing key for the UI cookie. Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
CLOCK_SECRET_KEY=

# Passphrase for the fallback WiFi setup hotspot (deploy/clock-hotspot.service).
# If the house WiFi password ever changes, this is the only way back into the
# clock: it puts up a network called `weasley-clock-setup` that somebody
# standing at it can join on a phone to type the new password in.
#
# WRITE THIS ON A LABEL INSIDE THE CABINET. The person who needs it will be
# standing at the clock in another state with no other way to find it out.
#
# 8 to 63 characters. Generate one with:
#   python -m clockd.hotspot --suggest-password
#
# Leave it empty and the clock will never raise the hotspot -- which is the
# right default, because an open network called "weasley-clock-setup" would
# let any passer-by read the house WiFi password out of the setup page.
CLOCK_HOTSPOT_PASSWORD=

# Broker accounts, written by deploy/mosquitto-setup.sh. MQTT_PASSWORD above is
# the controller's; this one is for the six ESP32 display nodes, which get a
# separate account that can read its own display topic and nothing else. You
# need its value when you flash each node's config.json.
MQTT_DISPLAY_PASSWORD=

# Optional: Home Assistant REST source (P2)
HASS_URL=
HASS_TOKEN=

# Optional alerting. Both are URLs that act as credentials, which is why they
# live here and not in config/clock.yaml. Set alerts.enabled: true as well.
#
# healthchecks.io -- the dead-man's switch. The controller pings this on a
# timer; if the pings stop, healthchecks emails you. This is the one that
# catches a Pi that has lost power, lost WiFi or hung, because in those cases
# the controller cannot tell you anything itself.
#   Make a check at https://healthchecks.io, period 10 min, grace 20 min.
HEALTHCHECKS_URL=

# ntfy.sh -- push notifications saying *what* broke, while the Pi is still
# alive enough to say so. Pick an unguessable topic name: anyone who knows it
# can read your notifications.
#   NTFY_URL=https://ntfy.sh/weasley-clock-7f3a9c2e
NTFY_URL=
